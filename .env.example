# Get a key at https://console.anthropic.com/ and copy this file to .env.local
ANTHROPIC_API_KEY=

# Optional: lets the AI find images for slides without an uploaded photo.
# Stock photos (free): https://www.pexels.com/api/
PEXELS_API_KEY=
# Web images of specific places/products (paid, with monthly free credit): https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
